# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false
SECRET_KEY=change-this-in-production-super-secret-key-at-least-32-chars

# Database Configuration (PostgreSQL default, or sqlite+aiosqlite for local zero-dependency development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newtonite_ops
# For SQLite local fallback testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./newtonite_ops.db

# Worker & Background Processing
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_RETRIES=5
